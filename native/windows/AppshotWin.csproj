<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>appshot-win-x64</AssemblyName>
    <RootNamespace>AppshotWin</RootNamespace>
    <!-- 托管 UIA（System.Windows.Automation）依赖 WindowsDesktop 框架引用 -->
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AppshotWin.Tests\**" />
    <Compile Remove="HookProbe\**" />
    <EmbeddedResource Remove="AppshotWin.Tests\**" />
    <EmbeddedResource Remove="HookProbe\**" />
    <None Remove="AppshotWin.Tests\**" />
    <None Remove="HookProbe\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\shutter.wav" />
  </ItemGroup>

</Project>
